    "maintainer": "GNS3 Team",
    "maintainer_email": "developers@gns3.net",
    "usage": "\nUsername: alpine\nPassword: alpine",
    "settings": [
        {
            "name": "default",
            "default": true,
            "template_type": "qemu",
            "template_properties": {
                "port_name_format": "eth{0}",
                "adapter_type": "virtio-net-pci",
                "adapters": 1,
                "ram": 1024,
                "hda_disk_interface": "virtio",
                "console_type": "telnet",
                "boot_priority": "c",
                "options": "-nographic",
                "uefi": true
            }
        },
        {
            "name": "x86_64",
            "template_type": "qemu",
            "template_properties": {
                "platform": "x86_64"
            }
        },
        {
            "name": "aarch64",
            "template_type": "qemu",
            "template_properties": {
                "platform": "aarch64"
            }
        }
    ],
